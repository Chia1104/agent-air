{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "'~/.codex/hooks/cbm-code-discovery-gate'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "'~/.codex/hooks/cbm-session-reminder'"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "'~/.codex/hooks/cbm-session-reminder'"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "'~/.codex/hooks/cbm-session-reminder'"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "'~/.codex/hooks/cbm-session-reminder'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '~/.codex/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
